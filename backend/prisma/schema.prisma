  updatedAt         DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt         DateTime?        @map("deleted_at") @db.Timestamptz

  agency            Agency           @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  branch            AgencyBranch     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  employee          Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  client            Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  clientSite        ClientSite       @relation(fields: [clientSiteId], references: [id], onDelete: Restrict)
  designation       Designation      @relation(fields: [designationId], references: [id], onDelete: Restrict)
