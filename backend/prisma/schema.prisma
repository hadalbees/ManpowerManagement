generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. ENUMS (22 Domain State Machines)
// ==========================================

enum AgencyStatus {
  ACTIVE
  SUSPENDED
  INACTIVE

  @@map("agency_status_enum")
}

enum UserStatus {
  ACTIVE
  LOCKED
  INACTIVE

  @@map("user_status_enum")
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  BLACKLISTED

  @@map("client_status_enum")
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED

  @@map("contract_status_enum")
}

enum BillingCycle {
  WEEKLY
  FORTNIGHTLY
  MONTHLY
  QUARTERLY

  @@map("billing_cycle_enum")
}

enum BillingModel {
  MONTHLY_FIXED
  PER_EMPLOYEE_PER_SHIFT
  HOURLY
  OVERTIME

  @@map("billing_model_enum")
}

enum DesignationCategory {
  DRIVER
  SECURITY
  HOUSEKEEPING
  INDUSTRIAL
  WAREHOUSE
  ADMINISTRATIVE

  @@map("designation_category_enum")
}

enum Gender {
  MALE
  FEMALE
  OTHER

  @@map("gender_enum")
}

enum MaritalStatus {
  SINGLE
  MARRIED
  WIDOWED
  DIVORCED

  @@map("marital_status_enum")
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  RESIGNED
  TERMINATED

  @@map("employee_status_enum")
}

enum ProficiencyLevel {
  BEGINNER
  INTERMEDIATE
  EXPERT

  @@map("proficiency_enum")
}

enum AdvanceStatus {
  ACTIVE
  FULLY_RECOVERED
  WRITTEN_OFF

  @@map("advance_status_enum")
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED

  @@map("leave_status_enum")
}

enum VehicleType {
  SEDAN
  SUV
  BUS
  VAN
  TRUCK
  AUTO

  @@map("vehicle_type_enum")
}

enum FuelType {
  DIESEL
  PETROL
  CNG
  ELECTRIC

  @@map("fuel_type_enum")
}

enum VehicleStatus {
  AVAILABLE
  ASSIGNED
  UNDER_MAINTENANCE
  GROUNDED

  @@map("vehicle_status_enum")
}

enum DeploymentStatus {
  ACTIVE
  TRANSFERRED
  REPLACED
  COMPLETED

  @@map("deployment_status_enum")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  PAID_LEAVE
  UNPAID_LEAVE
  WEEK_OFF
  HOLIDAY

  @@map("attendance_status_enum")
}

enum AttendanceMethod {
  WEB_MANUAL
  TABLET_MANUAL
  CSV_IMPORT
  BIOMETRIC
  MOBILE_GPS

  @@map("attendance_method_enum")
}

enum ReplacementType {
  TEMPORARY
  PERMANENT

  @@map("replacement_type_enum")
}

enum ReplacementStatus {
  DISPATCHED
  COMPLETED
  CANCELLED

  @@map("replacement_status_enum")
}

enum StatutoryRuleType {
  EPF
  ESIC
  PROFESSIONAL_TAX
  LWF

  @@map("statutory_rule_type_enum")
}

enum StatutoryCalcMethod {
  PERCENTAGE_ON_GROSS
  PERCENTAGE_ON_BASIC_DA
  SLAB_BASED
  FIXED_AMOUNT

  @@map("statutory_calc_method_enum")
}

enum RoundingMethod {
  NEAREST_INTEGER
  ROUND_UP
  ROUND_DOWN
  EXACT

  @@map("rounding_method_enum")
}

enum PayrollBatchStatus {
  DRAFT
  REVIEWED
  APPROVED
  LOCKED

  @@map("payroll_batch_status_enum")
}

enum SalaryPaymentStatus {
  PENDING
  PAID
  FAILED

  @@map("salary_payment_status_enum")
}

enum InvoiceStatus {
  DRAFT
  APPROVED
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED

  @@map("invoice_status_enum")
}

enum InvoiceAdjustmentType {
  CREDIT_NOTE
  DEBIT_NOTE

  @@map("invoice_adjustment_type_enum")
}

enum PaymentMode {
  NEFT
  RTGS
  CHEQUE
  UPI
  CASH

  @@map("payment_mode_enum")
}

enum DocumentEntityType {
  EMPLOYEE
  VEHICLE
  CLIENT
  CLIENT_SITE
  CONTRACT
  CANDIDATE
  AGENCY
  BRANCH

  @@map("document_entity_type_enum")
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED

  @@map("verification_status_enum")
}

enum ExpiryAlertStatus {
  SCHEDULED
  SENT
  ACKNOWLEDGED
  RESOLVED

  @@map("expiry_alert_status_enum")
}

enum RecruitmentStatus {
  APPLIED
  SCREENING
  INTERVIEW_SCHEDULED
  SKILL_TEST_PASSED
  DOCUMENT_VERIFIED
  SELECTED
  OFFERED
  HIRED
  REJECTED

  @@map("recruitment_status_enum")
}

enum CandidateOfferStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED

  @@map("candidate_offer_status_enum")
}

enum InterviewResult {
  PENDING
  PASSED
  FAILED
  RESCHEDULED

  @@map("interview_result_enum")
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL

  @@map("notification_priority_enum")
}

enum NotificationCategory {
  EXPIRY
  COMPLIANCE
  ATTENDANCE
  REPLACEMENT
  PAYROLL
  BILLING
  RECRUITMENT
  LEAVE
  SYSTEM

  @@map("notification_category_enum")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  LOCK
  OVERRIDE

  @@map("audit_action_enum")
}

// ==========================================
// 2. AGENCY & BRANCH INFRASTRUCTURE
// ==========================================

model Agency {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String       @db.VarChar(150)
  legalName           String       @map("legal_name") @db.VarChar(200)
  registrationNumber  String       @unique @map("registration_number") @db.VarChar(50)
  pan                 String       @unique @db.VarChar(10)
  gstin               String       @unique @db.VarChar(15)
  epfCode             String?      @map("epf_code") @db.VarChar(25)
  esicCode            String?      @map("esic_code") @db.VarChar(25)
  linNumber           String?      @map("lin_number") @db.VarChar(20)
  registeredAddress   String       @map("registered_address") @db.Text
  stateCode           String       @map("state_code") @db.VarChar(2)
  phone               String       @db.VarChar(20)
  email               String       @db.VarChar(100)
  website             String?      @db.VarChar(150)
  status              AgencyStatus @default(ACTIVE)
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt           DateTime?    @map("deleted_at") @db.Timestamptz

  branches            AgencyBranch[]
  configurations      AgencyConfiguration[]
  users               User[]
  roles               Role[]
  clients             Client[]
  designations        Designation[]
  employees           Employee[]
  skills              Skill[]
  leaveTypes          LeaveType[]
  vehicles            Vehicle[]
  deployments         EmployeeDeployment[]
  attendances         Attendance[]
  statutoryRules      StatutoryRule[]
  payrollBatches      PayrollBatch[]
  invoiceSequences    InvoiceSequence[]
  invoices            ClientInvoice[]
  invoiceAdjustments  InvoiceAdjustment[]
  clientPayments      ClientPayment[]
  documentTypes       DocumentType[]
  documents           Document[]
  expiryAlerts        ExpiryAlert[]
  candidates          RecruitmentCandidate[]
  candidateOffers     CandidateOffer[]
  notifications       Notification[]
  auditLogs           AuditLog[]

  @@map("agencies")
}

model AgencyBranch {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencyId        String    @map("agency_id") @db.Uuid
  branchName      String    @map("branch_name") @db.VarChar(100)
  branchCode      String    @map("branch_code") @db.VarChar(10)
  gstin           String?   @db.VarChar(15)
  stateCode       String    @map("state_code") @db.VarChar(2)
  city            String    @db.VarChar(50)
  address         String    @db.Text
  contactPerson   String    @map("contact_person") @db.VarChar(100)
  contactPhone    String    @map("contact_phone") @db.VarChar(20)
  contactEmail    String    @map("contact_email") @db.VarChar(100)
  isHeadquarters  Boolean   @default(false) @map("is_headquarters")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz

  agency          Agency    @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  configurations  AgencyConfiguration[]
  users           User[]
  clients         Client[]
  employees       Employee[]
  vehicles        Vehicle[]
  deployments     EmployeeDeployment[]
  attendances     Attendance[]
  payrollBatches  PayrollBatch[]
  invoiceSequences InvoiceSequence[]
  invoices        ClientInvoice[]
  invoiceAdjustments InvoiceAdjustment[]
  clientPayments  ClientPayment[]
  candidates      RecruitmentCandidate[]
  candidateOffers     CandidateOffer[]
  auditLogs       AuditLog[]

  @@unique([agencyId, branchCode])
  @@map("agency_branches")
}

model AgencyConfiguration {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencyId    String    @map("agency_id") @db.Uuid
  branchId    String?   @map("branch_id") @db.Uuid
  configKey   String    @map("config_key") @db.VarChar(50)
  configValue Json      @map("config_value")
  description String?   @db.VarChar(255)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  agency      Agency    @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  branch      AgencyBranch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([agencyId, branchId, configKey])
  @@map("agency_configurations")
}

// ==========================================
// 3. IDENTITY, PERMISSIONS & AUDIT
// ==========================================

model User {
  id                   String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencyId             String     @map("agency_id") @db.Uuid
  branchId             String?    @map("branch_id") @db.Uuid
  email                String     @db.VarChar(150)
  passwordHash         String     @map("password_hash") @db.VarChar(255)
  fullName             String     @map("full_name") @db.VarChar(100)
  phone                String     @db.VarChar(20)
  roleId               String     @map("role_id") @db.Uuid
  status               UserStatus @default(ACTIVE)
  failedLoginAttempts  Int        @default(0) @map("failed_login_attempts")
  lockedUntil          DateTime?  @map("locked_until") @db.Timestamptz
  lastLoginAt          DateTime?  @map("last_login_at") @db.Timestamptz
  lastLoginIp          String?    @map("last_login_ip") @db.VarChar(45)
  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt            DateTime?  @map("deleted_at") @db.Timestamptz

  agency               Agency     @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  branch               AgencyBranch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  role                 Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)

  userPermissions      UserPermission[] @relation("TargetUser")
  grantedPermissions   UserPermission[] @relation("GrantedByUser")
  sessions             UserSession[]
  auditLogs            AuditLog[]
  recordedAttendances  Attendance[]     @relation("RecordedByUser")
  approvedAttendances  Attendance[]     @relation("ApprovedByUser")
  dispatchedReplacements Replacement[]  @relation("DispatchedByUser")
  assignedVehicles     VehicleAssignment[] @relation("AssignedByUser")
  approvedAdvances     SalaryAdvance[]  @relation("ApprovedAdvanceByUser")
  reviewedLeaves       LeaveRequest[]   @relation("ReviewedLeaveByUser")
  approvedPayroll      PayrollBatch[]   @relation("ApprovedPayrollByUser")
  approvedInvoices     ClientInvoice[]  @relation("ApprovedInvoiceByUser")
  approvedAdjustments  InvoiceAdjustment[] @relation("ApprovedAdjustmentByUser")
  recordedPayments     ClientPayment[]  @relation("RecordedPaymentByUser")
  verifiedDocuments    Document[]       @relation("VerifiedByUser")
  uploadedDocuments    Document[]       @relation("UploadedByUser")
  uploadedDocVersions  DocumentVersion[] @relation("DocumentVersionUploadedBy")
  acknowledgedAlerts   ExpiryAlert[]    @relation("AcknowledgedAlertByUser")
  conductedInterviews  CandidateInterview[] @relation("InterviewerUser")
  screenedCandidates   RecruitmentCandidate[] @relation("ScreenedByUser")
  notifications        Notification[]

  @@unique([agencyId, email])
  @@map("users")
}

model Role {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencyId        String?   @map("agency_id") @db.Uuid
  name            String    @db.VarChar(50)
  slug            String    @unique @db.VarChar(50)
  description     String?   @db.VarChar(255)
  isSystemDefault Boolean   @default(false) @map("is_system_default")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  agency          Agency?   @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  module          String    @db.VarChar(40)
  action          String    @db.VarChar(30)
  code            String    @unique @db.VarChar(70)
  description     String    @db.VarChar(255)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserPermission {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String     @map("user_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  isGranted    Boolean    @map("is_granted")
  grantedById  String     @map("granted_by") @db.Uuid
  grantedAt    DateTime   @default(now()) @map("granted_at") @db.Timestamptz

  user         User       @relation("TargetUser", fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  grantedBy    User       @relation("GrantedByUser", fields: [grantedById], references: [id], onDelete: Restrict)

  @@unique([userId, permissionId])
  @@map("user_permissions")
}

model UserSession {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.VarChar(255)
  userAgent        String?   @map("user_agent") @db.VarChar(255)
  ipAddress        String?   @map("ip_address") @db.VarChar(45)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz
  isRevoked        Boolean   @default(false) @map("is_revoked")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastActiveAt     DateTime  @default(now()) @map("last_active_at") @db.Timestamptz

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

model AuditLog {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencyId      String      @map("agency_id") @db.Uuid
  branchId      String?     @map("branch_id") @db.Uuid
  userId        String?     @map("user_id") @db.Uuid
  entityName    String      @map("entity_name") @db.VarChar(60)
  entityId      String      @map("entity_id") @db.Uuid
  action        AuditAction
  oldValues     Json?       @map("old_values")
  newValues     Json?       @map("new_values")
  changeSummary String?     @map("change_summary") @db.VarChar(255)
  ipAddress     String?     @map("ip_address") @db.VarChar(45)
  userAgent     String?     @map("user_agent") @db.VarChar(255)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz

  agency        Agency      @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  branch        AgencyBranch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityName, entityId])
  @@index([createdAt])
  @@index([agencyId, userId])
  @@map("audit_logs")
}

// ==========================================
// 4. CLIENT & COMMERCIAL DOMAIN
// ==========================================

model Client {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencyId          String       @map("agency_id") @db.Uuid
  branchId          String       @map("branch_id") @db.Uuid
  clientCode        String       @map("client_code") @db.VarChar(20)
  companyName       String       @map("company_name") @db.VarChar(150)
  legalName         String       @map("legal_name") @db.VarChar(200)
  pan               String       @db.VarChar(10)
  gstin             String       @db.VarChar(15)
  stateCode         String       @map("state_code") @db.VarChar(2)
  billingAddress    String       @map("billing_address") @db.Text
  contactPersonName String       @map("contact_person_name") @db.VarChar(100)
  contactEmail      String       @map("contact_email") @db.VarChar(100)
  contactPhone      String       @map("contact_phone") @db.VarChar(20)
  paymentTermsDays  Int          @default(30) @map("payment_terms_days")
  status            ClientStatus @default(ACTIVE)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt         DateTime?    @map("deleted_at") @db.Timestamptz

  agency            Agency       @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  branch            AgencyBranch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  sites             ClientSite[]
  contracts         ClientContract[]
  billingRates      ClientBillingRate[]
  vehicles          Vehicle[]
  deployments       EmployeeDeployment[]
  attendances       Attendance[]
  invoices          ClientInvoice[]
  payments          ClientPayment[]

  @@unique([agencyId, clientCode])
  @@unique([agencyId, gstin])
  @@map("clients")
}

model ClientSite {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId            String       @map("client_id") @db.Uuid
  siteCode            String       @map("site_code") @db.VarChar(20)
  siteName            String       @map("site_name") @db.VarChar(120)
  address             String       @db.Text
  city                String       @db.VarChar(50)
  stateCode           String       @map("state_code") @db.VarChar(2)
  pincode             String       @db.VarChar(10)
  siteSupervisorName  String?      @map("site_supervisor_name") @db.VarChar(100)
  siteSupervisorPhone String?      @map("site_supervisor_phone") @db.VarChar(20)
  isActive            Boolean      @default(true) @map("is_active")
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt           DateTime?    @map("deleted_at") @db.Timestamptz

  client              Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)

  billingRates        ClientBillingRate[]
  deployments         EmployeeDeployment[]
  attendances         Attendance[]
  invoiceItems        ClientInvoiceItem[]
  vehicleAssignments  VehicleAssignment[]

  @@unique([clientId, siteCode])
  @@map("client_sites")
}

model ClientContract {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId         String         @map("client_id") @db.Uuid
  contractNumber   String         @map("contract_number") @db.VarChar(50)
  title            String         @db.VarChar(150)
  startDate        DateTime       @map("start_date") @db.Date
  endDate          DateTime       @map("end_date") @db.Date
  noticePeriodDays Int            @default(30) @map("notice_period_days")
  billingCycle     BillingCycle   @default(MONTHLY) @map("billing_cycle")
  status           ContractStatus @default(ACTIVE)
  autoRenew        Boolean        @default(false) @map("auto_renew")
  notes            String?        @db.Text
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt        DateTime?      @map("deleted_at") @db.Timestamptz

  client           Client         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  invoices         ClientInvoice[]

  @@unique([clientId, contractNumber])
  @@map("client_contracts")
}

model ClientBillingRate {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId           String       @map("client_id") @db.Uuid
  clientSiteId       String?      @map("client_site_id") @db.Uuid
  designationId      String       @map("designation_id") @db.Uuid
  billingModel       BillingModel @map("billing_model")
  rateAmount         Decimal      @map("rate_amount") @db.Decimal(12, 2)
  standardShiftHours Decimal      @default(8.00) @map("standard_shift_hours") @db.Decimal(4, 2)
  otHourlyRate       Decimal      @default(0.00) @map("ot_hourly_rate") @db.Decimal(10, 2)
  effectiveFrom      DateTime     @map("effective_from") @db.Date
  effectiveTo        DateTime?    @map("effective_to") @db.Date
  isActive           Boolean      @default(true) @map("is_active")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt          DateTime?    @map("deleted_at") @db.Timestamptz

  client             Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  clientSite         ClientSite?  @relation(fields: [clientSiteId], references: [id], onDelete: SetNull)
  designation        Designation  @relation(fields: [designationId], references: [id], onDelete: Restrict)

  deployments        EmployeeDeployment[]
  invoiceItems       ClientInvoiceItem[]

  @@map("client_billing_rates")
}

// ==========================================
// 5. WORKFORCE & HUMAN RESOURCES
// ==========================================

model Designation {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencyId            String              @map("agency_id") @db.Uuid
  name                String              @db.VarChar(80)
  code                String              @db.VarChar(20)
  category            DesignationCategory
  description         String?             @db.VarChar(255)
  minimumWageCategory String?             @map("minimum_wage_category") @db.VarChar(40)
  isActive            Boolean             @default(true) @map("is_active")
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt           DateTime?           @map("deleted_at") @db.Timestamptz

  agency              Agency              @relation(fields: [agencyId], references: [id], onDelete: Restrict)

  employees           Employee[]
  billingRates        ClientBillingRate[]
  deployments         EmployeeDeployment[]
  invoiceItems        ClientInvoiceItem[]
  candidates          RecruitmentCandidate[]
