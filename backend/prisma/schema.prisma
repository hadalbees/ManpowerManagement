  lwfEmployee           Decimal             @default(0.00) @map("lwf_employee") @db.Decimal(8, 2)
  advanceDeduction      Decimal             @default(0.00) @map("advance_deduction") @db.Decimal(10, 2)
  otherDeductions       Decimal             @default(0.00) @map("other_deductions") @db.Decimal(10, 2)
  totalDeductions       Decimal             @map("total_deductions") @db.Decimal(10, 2)
