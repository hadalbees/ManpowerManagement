  shiftEndTime      DateTime         @default(dbgenerated("'18:00:00'::time")) @map("shift_end_time") @db.Time
  isNightShift      Boolean          @default(false) @map("is_night_shift")
  startDate         DateTime         @map("start_date") @db.Date
