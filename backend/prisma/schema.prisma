  invoiceDate           DateTime           @map("invoice_date") @db.Date
  dueDate               DateTime           @map("due_date") @db.Date
  billingPeriodStart    DateTime           @map("billing_period_start") @db.Date
  billingPeriodEnd      DateTime           @map("billing_period_end") @db.Date
  subtotalAmount        Decimal            @map("subtotal_amount") @db.Decimal(14, 2)
  isInterstate          Boolean            @default(false) @map("is_interstate")
  cgstRate              Decimal            @default(0.00) @map("cgst_rate") @db.Decimal(5, 2)
  cgstAmount            Decimal            @default(0.00) @map("cgst_amount") @db.Decimal(12, 2)
  sgstRate              Decimal            @default(0.00) @map("sgst_rate") @db.Decimal(5, 2)
  sgstAmount            Decimal            @default(0.00) @map("sgst_amount") @db.Decimal(12, 2)
  igstRate              Decimal            @default(0.00) @map("igst_rate") @db.Decimal(5, 2)
  igstAmount            Decimal            @default(0.00) @map("igst_amount") @db.Decimal(12, 2)
  totalTaxAmount        Decimal            @default(0.00) @map("total_tax_amount") @db.Decimal(12, 2)
  roundOff              Decimal            @default(0.00) @map("round_off") @db.Decimal(5, 2)
  totalInvoiceAmount    Decimal            @map("total_invoice_amount") @db.Decimal(14, 2)
  paidAmount            Decimal            @default(0.00) @map("paid_amount") @db.Decimal(14, 2)
  creditAdjustmentAmount Decimal           @default(0.00) @map("credit_adjustment_amount") @db.Decimal(14, 2)
  balanceDue            Decimal            @map("balance_due") @db.Decimal(14, 2)
  status                InvoiceStatus      @default(DRAFT)
  isLocked              Boolean            @default(false) @map("is_locked")
  approvedById          String?            @map("approved_by") @db.Uuid
  pdfStorageKey         String?            @map("pdf_storage_key") @db.VarChar(255)
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
