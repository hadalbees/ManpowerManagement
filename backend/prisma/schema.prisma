  lineTotal              Decimal      @map("line_total") @db.Decimal(12, 2)
  createdAt              DateTime     @default(now()) @map("created_at") @db.Timestamptz

  invoice                ClientInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  clientSite             ClientSite    @relation(fields: [clientSiteId], references: [id], onDelete: Restrict)
  designation            Designation   @relation(fields: [designationId], references: [id], onDelete: Restrict)
  billingRate            ClientBillingRate @relation(fields: [billingRateId], references: [id], onDelete: Restrict)

