}

model Notification {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencyId      String               @map("agency_id") @db.Uuid
  branchId      String?              @map("branch_id") @db.Uuid
  userId        String               @map("user_id") @db.Uuid
  title         String               @db.VarChar(120)
  body          String               @db.Text
  category      NotificationCategory
  priority      NotificationPriority @default(NORMAL)
  actionUrl     String?              @map("action_url") @db.VarChar(255)
  referenceType String?              @map("reference_type") @db.VarChar(50)
  referenceId   String?              @map("reference_id") @db.VarChar(100)
  dedupKey      String?              @unique @map("dedup_key") @db.VarChar(150)
  isRead        Boolean              @default(false) @map("is_read")
  readAt        DateTime?            @map("read_at") @db.Timestamptz
  expiresAt     DateTime?            @map("expires_at") @db.Timestamptz
  metadata      Json?                @map("metadata")
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz

  agency        Agency               @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}
