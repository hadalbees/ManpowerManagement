// ==========================================
// 10. DOCUMENT MANAGEMENT & EXPIRY ALERTS
// ==========================================

model DocumentType {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencyId           String             @map("agency_id") @db.Uuid
  name               String             @db.VarChar(80)
  code               String             @db.VarChar(30)
  applicableEntity   DocumentEntityType @map("applicable_entity")
  isMandatory        Boolean            @default(false) @map("is_mandatory")
  requiresExpiryDate Boolean            @default(false) @map("requires_expiry_date")
  defaultAlertDays   Int[]              @default([60, 30, 15, 7]) @map("default_alert_days")
  isActive           Boolean            @default(true) @map("is_active")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz

  agency             Agency             @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  documents          Document[]

  @@unique([agencyId, code])
  @@map("document_types")
}

model Document {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencyId           String             @map("agency_id") @db.Uuid
  branchId           String?            @map("branch_id") @db.Uuid
  documentTypeId     String             @map("document_type_id") @db.Uuid
  entityType         DocumentEntityType @map("entity_type")
  entityId           String             @map("entity_id") @db.Uuid
  documentNumber     String?            @map("document_number") @db.VarChar(100)
  title              String?            @db.VarChar(150)
  description        String?            @db.Text
  issuedBy           String?            @map("issued_by") @db.VarChar(100)
  issueDate          DateTime?          @map("issue_date") @db.Date
  expiryDate         DateTime?          @map("expiry_date") @db.Date
  storageProvider    String             @default("S3_COMPLIANT") @map("storage_provider") @db.VarChar(50)
  s3StorageKey       String             @map("s3_storage_key") @db.VarChar(255)
  originalFileName   String             @map("original_file_name") @db.VarChar(150)
  fileSizeBytes      Int                @map("file_size_bytes")
  mimeType           String             @map("mime_type") @db.VarChar(60)
  checksum           String?            @db.VarChar(64)
  version            Int                @default(1)
  isCurrent          Boolean            @default(true) @map("is_current")
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  uploadedById       String?            @map("uploaded_by") @db.Uuid
  verifiedById       String?            @map("verified_by") @db.Uuid
  verifiedAt         DateTime?          @map("verified_at") @db.Timestamptz
  rejectionReason    String?            @map("rejection_reason") @db.VarChar(255)
  metadata           Json?              @map("metadata")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt          DateTime?          @map("deleted_at") @db.Timestamptz

  agency             Agency             @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  documentType       DocumentType       @relation(fields: [documentTypeId], references: [id], onDelete: Restrict)
  uploadedBy         User?              @relation("UploadedByUser", fields: [uploadedById], references: [id], onDelete: SetNull)
  verifiedBy         User?              @relation("VerifiedByUser", fields: [verifiedById], references: [id], onDelete: SetNull)

  versions           DocumentVersion[]
  alerts             ExpiryAlert[]

  @@index([entityType, entityId])
  @@index([expiryDate])
  @@map("documents")
}

model DocumentVersion {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId       String   @map("document_id") @db.Uuid
  versionNumber    Int      @map("version_number")
  s3StorageKey     String   @map("s3_storage_key") @db.VarChar(255)
  originalFileName String   @map("original_file_name") @db.VarChar(150)
  fileSizeBytes    Int      @map("file_size_bytes")
  mimeType         String   @map("mime_type") @db.VarChar(60)
  checksum         String?  @db.VarChar(64)
  uploadedById     String?  @map("uploaded_by_id") @db.Uuid
  reason           String?  @db.VarChar(255)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  document         Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy       User?    @relation("DocumentVersionUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@unique([documentId, versionNumber])
  @@map("document_versions")
}

model ExpiryAlert {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencyId            String             @map("agency_id") @db.Uuid
  documentId          String             @map("document_id") @db.Uuid
  entityType          DocumentEntityType @map("entity_type")
  entityId            String             @map("entity_id") @db.Uuid
  expiryDate          DateTime           @map("expiry_date") @db.Date
  alertThresholdDays  Int                @map("alert_threshold_days")
  scheduledAlertDate  DateTime           @map("scheduled_alert_date") @db.Date
  status              ExpiryAlertStatus  @default(SCHEDULED)
  sentAt              DateTime?          @map("sent_at") @db.Timestamptz
  acknowledgedById    String?            @map("acknowledged_by") @db.Uuid
  acknowledgedAt      DateTime?          @map("acknowledged_at") @db.Timestamptz
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz

  agency              Agency             @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  document            Document           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  acknowledgedBy      User?              @relation("AcknowledgedAlertByUser", fields: [acknowledgedById], references: [id], onDelete: SetNull)

  @@unique([documentId, alertThresholdDays])
  @@index([scheduledAlertDate, status])
  @@map("expiry_alerts")
}

