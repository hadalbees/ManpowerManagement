# ==============================================================================
# MANPOWER AGENCY MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and configure appropriate values for your target deployment.
# NEVER COMMIT ACTUAL CREDENTIALS, SECRETS, OR PASSWORDS TO SOURCE CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=4000
API_PREFIX=api/v1
APP_NAME="Apex Manpower Management Engine"

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL 16+)
# ------------------------------------------------------------------------------
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL="postgresql://db_user:db_password@localhost:5432/manpower_agency_db?schema=public&connection_limit=25&pool_timeout=10"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & JWT TOKENS
# ------------------------------------------------------------------------------
# Generate strong 256-bit cryptographic secrets: e.g. `openssl rand -hex 32`
JWT_SECRET=replace_with_cryptographically_random_256bit_hex_secret_in_production
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=replace_with_separate_random_256bit_hex_secret_in_production
JWT_REFRESH_EXPIRATION=7d

# ------------------------------------------------------------------------------
# 4. FIELD-LEVEL ENCRYPTION (AES-256-GCM)
# ------------------------------------------------------------------------------
# 32-byte hexadecimal encryption key for sensitive PII (Aadhaar, Bank Accounts)
DATABASE_ENCRYPTION_KEY_256=replace_with_32_byte_hex_key_e_g_openssl_rand_hex_32

# ------------------------------------------------------------------------------
# 5. STORAGE & DOCUMENT VAULT
# ------------------------------------------------------------------------------
STORAGE_DRIVER=local_private
STORAGE_LOCAL_ROOT="./storage/vault"
# Maximum allowed file upload size in bytes (15MB default)
MAX_FILE_SIZE_BYTES=15728640

# ------------------------------------------------------------------------------
# 6. HTTP SECURITY & CORS
# ------------------------------------------------------------------------------
# Comma-separated list of permitted frontend client origins (no wildcards in production)
CORS_ORIGINS=https://app.apexmanpower.com,https://admin.apexmanpower.com

# ------------------------------------------------------------------------------
# 7. LOGGING & OBSERVABILITY
# ------------------------------------------------------------------------------
LOG_LEVEL=info
ENABLE_DETAILED_AUDIT=true

# ------------------------------------------------------------------------------
# 8. SCHEDULER & COMPLIANCE
# ------------------------------------------------------------------------------
TIMEZONE=Asia/Kolkata
CRON_EXPIRY_SCAN_SCHEDULE="0 2 * * *"
