{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "manpowermanagement-api",
	"main": "src/main.ts",
	"compatibility_date": "2026-09-23",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "99313a8abef2411d84d79449fe964c3c"
		}
	],
	"alias": {
		"@nestjs/websockets/socket-module": "./src/cloudflare-empty.ts",
		"@nestjs/microservices/microservices-module": "./src/cloudflare-empty.ts",
		"@nestjs/microservices": "./src/cloudflare-empty.ts"
	}
}